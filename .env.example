# Sytist Production Dashboard — environment variables
# Copy this file to `server/.env` and fill in values.
# DO NOT commit the real .env file.

# ─── Server ────────────────────────────────────────────────
PORT=3011
NODE_ENV=development

# ─── Sytist MySQL (Phase 2+) ───────────────────────────────
# In dev: connects to droplet over public 3306
# In prod (later): switches to internal Docker network
SYTIST_DB_HOST=24.199.107.201
SYTIST_DB_PORT=3306
SYTIST_DB_USER=
SYTIST_DB_PASSWORD=
SYTIST_DB_NAME=sportsline

# ─── Auth (session secret) ─────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ─── Initial admin bootstrap (Phase 1) ─────────────────────
# Optional. If set AND no users exist yet, server creates this admin on
# first startup. Remove these vars after first login. Alternative: use the
# `npm run add-user` CLI tool in server/.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_DISPLAY_NAME=

# ─── ShipStation V1 (Phase 5) ──────────────────────────────
SHIPSTATION_API_KEY=
SHIPSTATION_API_SECRET=
SHIPSTATION_BASE_URL=https://ssapi.shipstation.com

# ─── ShipStation V2 (Phase 5) ──────────────────────────────
SHIPSTATION_V2_API_KEY=
SHIPSTATION_V2_BASE_URL=https://api.shipstation.com/v2

# ─── Output paths (Phase 4) ────────────────────────────────
DARKROOM_OUTPUT_PATH=Z:\Sytist\__Open Orders
DARKROOM_TEMPLATE_BASE_PATH=X:\Templates\Borders\sportsline borders
