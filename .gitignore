# Dependencies
node_modules/
*/node_modules/

# Build outputs
client/build/
build/
dist/

# Environment files (never commit)
.env
*.env
!.env.example
server/.env
client/.env

# Local SQLite databases (own dashboard storage)
server/config/*.db
server/config/*.db-shm
server/config/*.db-wal
server/config/*.sqlite
server/config/*.sqlite3

# Phase 49 v2: photo thumbnail proxy cache (regenerated on demand)
server/config/photo-cache/

# Local config that isn't committed
server/config/app-settings.json
server/config/folder-sort.json
server/config/imposition-layouts.json
server/config/path-overrides.json
server/config/size-mappings.json
server/config/specialty-products.json
server/config/template-mappings.json
server/config/sytist-status-map.json
server/config/filename-config.json
# Operator-authored via the Settings UI — same class as imposition-layouts.json
# above. Were tracked by oversight, which caused recurring working-tree
# "churn" and a near-miss git-checkout discard of real layouts (this session).
# Last good state is preserved in commit history; back up with server/config.
server/config/composite-layouts.json
server/config/composite-mappings.json

# Uploaded assets (user content, not source)
server/assets/overlays/*
server/assets/logos/*
server/assets/fonts/*
!server/assets/overlays/.gitkeep
!server/assets/logos/.gitkeep
!server/assets/fonts/.gitkeep

# Gallery-assets (operator-uploaded per-gallery logo registry + files — runtime data, analogous to server/assets/*)
server/config/gallery-assets.json
server/config/gallery-assets/logos/*
!server/config/gallery-assets/logos/.gitkeep

# Order asset overrides (Phase 50: operator-uploaded per-order, per-cart, per-slot image overrides — runtime data)
server/config/order-asset-overrides/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# OS noise
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# IDE
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
.claude/

# Misc
.cache/
*.tmp
*.temp
